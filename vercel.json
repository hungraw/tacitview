{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 20,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-RzDSS+EOgb1vZSFIstI/rtJdBIBT7lq9J1wSE4FUVKs='; style-src 'self' 'sha256-G46ekE50sK+/JTnSHFZoFH4N0yKIcnYYxVItA+zYCEo='; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:*; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "no-referrer"
        },
        {
          "key": "permissions-policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
        },
        {
          "key": "cross-origin-opener-policy",
          "value": "same-origin"
        },
        {
          "key": "cross-origin-resource-policy",
          "value": "same-origin"
        },
        {
          "key": "x-dns-prefetch-control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
